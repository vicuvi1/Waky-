# Copy to .env (optional). The bot token is NOT set here: paste it in Settings → Telegram.

# Where waky.json is kept. Default: the data/ folder next to this file.
# WAKY_DATA_DIR=C:\Users\you\Waky-data

# A second copy of waky.json after every change, e.g. a Google Drive folder.
# WAKY_BACKUP_DIR=G:\My Drive\Apps\WAKY\backup

# Local port for the app window.
# WAKY_PORT=48990
